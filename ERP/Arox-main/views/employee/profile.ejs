<div class="erp-h1" style="margin-bottom: 24px; color: #000000;">
  <div style="font-size: 24px; font-weight: 750;">My Account & Settings</div>
  <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">Employee profile, credentials, and notification settings</div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin-bottom: 32px;">
  <div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; padding: 24px;">
    <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
      <div style="width: 56px; height: 56px; border-radius: 12px; background: #000; color: #fff; font-size: 22px; font-weight: 750; display: flex; align-items: center; justify-content: center;">
        <%= (user.first_name || 'E').charAt(0).toUpperCase() %>
      </div>
      <div>
        <h3 style="font-size: 18px; font-weight: 750; color: #000; margin: 0;"><%= user.first_name %> <%= user.last_name %></h3>
        <span style="font-size: 11px; font-weight: 700; padding: 2px 8px; background: #000; color: #fff; border-radius: 4px; text-transform: uppercase;">
          <%= user.role || 'Employee' %>
        </span>
      </div>
    </div>

    <div style="display: flex; flex-direction: column; gap: 14px; font-size: 13px;">
      <div>
        <span style="color: #64748B; font-weight: 500; display: block; font-size: 11px;">EMAIL ADDRESS</span>
        <span style="font-weight: 600; color: #000;"><%= user.email %></span>
      </div>
      <div>
        <span style="color: #64748B; font-weight: 500; display: block; font-size: 11px;">DEPARTMENT</span>
        <span style="font-weight: 600; color: #000;">Corporate Outreach & Technical Training</span>
      </div>
      <div>
        <span style="color: #64748B; font-weight: 500; display: block; font-size: 11px;">ACCOUNT STATUS</span>
        <span style="font-weight: 600; color: #000;">Active & Verified</span>
      </div>
      <div>
        <span style="color: #64748B; font-weight: 500; display: block; font-size: 11px;">CURRENT APPRAISAL</span>
        <span style="font-weight: 700; color: #000;">★ <%= metrics ? metrics.rating : '4.8' %>/5.0 Top Performer</span>
      </div>
    </div>
  </div>

  <div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; padding: 24px;">
    <h3 style="font-size: 16px; font-weight: 750; color: #000; margin: 0 0 16px 0;">Workspace Preferences</h3>
    <div style="display: flex; flex-direction: column; gap: 14px; font-size: 13px;">
      <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
        <span>Email alert for upcoming follow-up calls</span>
        <input type="checkbox" checked style="accent-color: #000; width: 16px; height: 16px;">
      </label>
      <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
        <span>Notification on new lead assignment</span>
        <input type="checkbox" checked style="accent-color: #000; width: 16px; height: 16px;">
      </label>
      <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
        <span>Daily task summary email at 9:00 AM</span>
        <input type="checkbox" checked style="accent-color: #000; width: 16px; height: 16px;">
      </label>
    </div>
  </div>
</div>
