<div class="erp-h1" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>
    <div style="font-size: 24px; font-weight: 750;">Employee Tasks & Execution</div>
    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">Track assigned deliverables, outreach activities, and administrative deadlines</div>
  </div>
  <button onclick="openCreateTaskModal()" class="erp-btn erp-btn-sm" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #000; color: #fff; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; border: none;">
    <i data-lucide="plus" style="width: 15px; height: 15px;"></i>
    <span>Create Task</span>
  </button>
</div>

<style>
  .emp-task-tab {
    padding: 6px 14px; font-size: 12px; font-weight: 600; border-radius: 6px; text-decoration: none; color: #64748B; background: transparent; transition: all 0.15s ease;
  }
  .emp-task-tab.active {
    color: #000; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }
</style>

<!-- Task Filter Tabs -->
<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 24px;">
  <div style="display: inline-flex; background: #F1F5F9; padding: 4px; border-radius: 10px; border: 1px solid #E2E8F0;">
    <a href="/employee/tasks?status=all" class="emp-task-tab <%= activeStatus === 'all' ? 'active' : '' %>">
      All (<%= stats.total %>)
    </a>
    <a href="/employee/tasks?status=todo" class="emp-task-tab <%= activeStatus === 'todo' ? 'active' : '' %>">
      To Do (<%= stats.todo %>)
    </a>
    <a href="/employee/tasks?status=in_progress" class="emp-task-tab <%= activeStatus === 'in_progress' ? 'active' : '' %>">
      In Progress (<%= stats.in_progress %>)
    </a>
    <a href="/employee/tasks?status=completed" class="emp-task-tab <%= activeStatus === 'completed' ? 'active' : '' %>">
      Completed (<%= stats.completed %>)
    </a>
  </div>
</div>

<!-- Tasks List -->
<% if (tasks && tasks.length > 0) { %>
  <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px;">
    <% tasks.forEach(task => { %>
      <% if (task.status === 'completed') { %>
        <div class="erp-card" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px; padding: 16px 20px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px;">
      <% } else { %>
        <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 10px; padding: 16px 20px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px;">
      <% } %>
        <div style="display: flex; align-items: flex-start; gap: 14px; flex: 1; min-width: 260px;">
          <input type="checkbox" <%= task.status === 'completed' ? 'checked' : '' %> data-id="<%= task.id %>" onchange="handleTaskStatusToggleFromInput(this)" style="margin-top: 4px; width: 18px; height: 18px; cursor: pointer; accent-color: #000;">
          <div>
            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
              <% if (task.status === 'completed') { %>
                <span style="font-size: 14px; font-weight: 700; text-decoration: line-through; color: #64748B;">
                  <%= task.title %>
                </span>
              <% } else { %>
                <span style="font-size: 14px; font-weight: 700; color: #000;">
                  <%= task.title %>
                </span>
              <% } %>
              <span style="font-size: 10px; font-weight: 700; padding: 2px 6px; background: #F1F5F9; border-radius: 4px; text-transform: uppercase;">
                <%= task.category.replace('_', ' ') %>
              </span>
              <% if (task.priority === 'high') { %>
                <span style="font-size: 10px; font-weight: 700; padding: 2px 6px; background: #000; color: #fff; border-radius: 4px;">HIGH</span>
              <% } else if (task.priority === 'medium') { %>
                <span style="font-size: 10px; font-weight: 600; padding: 2px 6px; background: #E2E8F0; color: #000; border-radius: 4px;">MED</span>
              <% } else { %>
                <span style="font-size: 10px; font-weight: 500; padding: 2px 6px; background: #F8FAFC; color: #64748B; border-radius: 4px;">LOW</span>
              <% } %>
            </div>

            <% if (task.description) { %>
              <div style="font-size: 12px; color: #475569; margin-top: 4px;"><%= task.description %></div>
            <% } %>

            <div style="font-size: 11px; color: #64748B; margin-top: 6px; display: flex; gap: 12px; align-items: center;">
              <span><i data-lucide="calendar" style="width: 12px; height: 12px; display: inline-block; vertical-align: middle;"></i> Due: <%= task.due_date || 'No deadline' %></span>
              <% if (task.lead_title) { %>
                <span><i data-lucide="target" style="width: 12px; height: 12px; display: inline-block; vertical-align: middle;"></i> Linked: <%= task.lead_title %></span>
              <% } %>
            </div>
          </div>
        </div>

        <div style="display: flex; align-items: center; gap: 10px;">
          <select data-id="<%= task.id %>" onchange="handleTaskStageDropdownChange(this)" style="font-size: 11px; font-weight: 600; padding: 4px 8px; border: 1px solid #CBD5E1; border-radius: 6px; background: #fff; cursor: pointer;">
            <option value="todo" <%= task.status === 'todo' ? 'selected' : '' %>>To Do</option>
            <option value="in_progress" <%= task.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
            <option value="review" <%= task.status === 'review' ? 'selected' : '' %>>Review</option>
            <option value="completed" <%= task.status === 'completed' ? 'selected' : '' %>>Completed ✓</option>
          </select>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="erp-card" style="padding: 48px; text-align: center; background: #fff; border: 1px solid #E2E8F0; border-radius: 12px;">
    <i data-lucide="check-square" style="width: 40px; height: 40px; color: #94A3B8; margin: 0 auto 12px auto;"></i>
    <h3 style="font-size: 16px; font-weight: 700; color: #000; margin-bottom: 6px;">No tasks found in this view</h3>
    <p style="font-size: 13px; color: #64748B; margin-bottom: 16px;">Add personal tasks or outreach actions to organize your daily schedule.</p>
    <button onclick="openCreateTaskModal()" class="erp-btn erp-btn-sm" style="padding: 8px 16px; background: #000; color: #fff; border-radius: 8px; font-weight: 600; border: none; cursor: pointer;">
      Create Task Now
    </button>
  </div>
<% } %>

<!-- Modal: Create Task -->
<div id="createTaskModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #fff; border-radius: 14px; width: 100%; max-width: 480px; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h3 style="font-size: 18px; font-weight: 750; color: #000; margin: 0;">Create New Task</h3>
      <button onclick="closeCreateTaskModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #64748B;">&times;</button>
    </div>

    <form id="createTaskForm" onsubmit="handleCreateTask(event)">
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Task Title *</label>
          <input type="text" name="title" required placeholder="e.g. Follow up on proposal sent to Apex Systems" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>

        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Description</label>
          <textarea name="description" rows="2" placeholder="Specific action items, phone numbers, or links..." style="width: 100%; padding: 8px 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; resize: vertical;"></textarea>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Category</label>
            <select name="category" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; background: #fff;">
              <option value="client_outreach">Client Outreach</option>
              <option value="lead_qualification">Lead Qualification</option>
              <option value="follow_up">Follow-up Call</option>
              <option value="meeting">Meeting Preparation</option>
              <option value="documentation">Documentation / MOU</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Priority</label>
            <select name="priority" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; background: #fff;">
              <option value="high">High Priority</option>
              <option value="medium" selected>Medium Priority</option>
              <option value="low">Low Priority</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Due Date</label>
            <input type="date" name="due_date" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Linked Deal (Optional)</label>
            <select name="lead_id" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; background: #fff;">
              <option value="">-- None --</option>
              <% if (leads && leads.length > 0) { %>
                <% leads.forEach(l => { %>
                  <option value="<%= l.id %>"><%= l.title %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px;">
        <button type="button" onclick="closeCreateTaskModal()" style="padding: 8px 16px; background: #F1F5F9; color: #334155; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">Cancel</button>
        <button type="submit" id="saveTaskBtn" style="padding: 8px 18px; background: #000; color: #fff; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">Save Task</button>
      </div>
    </form>
  </div>
</div>

<script>
  function handleTaskStatusToggleFromInput(checkbox) {
    if (!checkbox || !checkbox.dataset || !checkbox.dataset.id) return;
    handleTaskStatusToggle(checkbox.dataset.id, checkbox.checked);
  }

  function handleTaskStageDropdownChange(sel) {
    if (!sel || !sel.dataset || !sel.dataset.id) return;
    updateTaskStageDropdown(sel.dataset.id, sel.value);
  }

  function openCreateTaskModal() {
    document.getElementById('createTaskModal').style.display = 'flex';
  }
  function closeCreateTaskModal() {
    document.getElementById('createTaskModal').style.display = 'none';
  }

  async function handleTaskStatusToggle(id, isChecked) {
    const status = isChecked ? 'completed' : 'todo';
    await updateTaskStageDropdown(id, status);
  }

  async function updateTaskStageDropdown(id, status) {
    try {
      const res = await fetch(`/api/employee/tasks/${id}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Failed to update task');
      }
    } catch (e) {
      alert('Error updating task status');
    }
  }

  async function handleCreateTask(e) {
    e.preventDefault();
    const btn = document.getElementById('saveTaskBtn');
    btn.disabled = true;
    btn.textContent = 'Saving...';

    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    try {
      const res = await fetch('/api/employee/tasks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        window.location.reload();
      } else {
        alert(result.message || 'Failed to create task');
        btn.disabled = false;
        btn.textContent = 'Save Task';
      }
    } catch (err) {
      alert('Error creating task');
      btn.disabled = false;
      btn.textContent = 'Save Task';
    }
  }
</script>
