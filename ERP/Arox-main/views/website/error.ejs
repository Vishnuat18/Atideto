<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Error - Atideto Technologies ERP' %></title>
  <link rel="icon" type="image/svg+xml" href="/erp-assets/favicon.svg">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Montserrat', -apple-system, sans-serif; }
    body { background-color: #07090e; color: #f8fafc; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }
    .error-card { background: #0f121d; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 48px 36px; max-width: 480px; width: 100%; text-align: center; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5); }
    .error-code { font-size: 5rem; font-weight: 800; color: #fff; line-height: 1; margin-bottom: 12px; letter-spacing: -0.04em; }
    .error-title { font-size: 1.25rem; font-weight: 700; color: #f8fafc; margin-bottom: 12px; }
    .error-msg { font-size: 0.9rem; color: #94a3b8; line-height: 1.6; margin-bottom: 32px; }
    .btn-action { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 24px; border-radius: 8px; font-size: 0.875rem; font-weight: 600; text-decoration: none; cursor: pointer; transition: all 0.2s ease; }
    .btn-primary { background: #000; color: #fff; border: 1px solid #334155; }
    .btn-primary:hover { background: #1e293b; }
    .btn-secondary { background: transparent; color: #94a3b8; border: 1px solid rgba(255,255,255,0.12); margin-left: 8px; }
    .btn-secondary:hover { color: #fff; border-color: rgba(255,255,255,0.3); }
  </style>
</head>
<body>
  <div class="error-card">
    <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(255,255,255,0.06); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
      <i data-lucide="alert-circle" style="width: 28px; height: 28px; color: #94a3b8;"></i>
    </div>
    <div class="error-code"><%= typeof code !== 'undefined' ? code : 404 %></div>
    <div class="error-title"><%= typeof code !== 'undefined' && code === 404 ? 'Page Not Found' : (typeof code !== 'undefined' && code === 403 ? 'Access Restricted' : 'Error Encountered') %></div>
    <p class="error-msg"><%= typeof message !== 'undefined' ? message : "The requested resource is unavailable in the ERP environment." %></p>
    <div style="display: flex; justify-content: center; flex-wrap: wrap; gap: 8px;">
      <a href="/login" class="btn-action btn-primary">
        <i data-lucide="layout-dashboard" style="width: 16px; height: 16px;"></i>
        <span>Go to ERP Dashboard</span>
      </a>
      <a href="javascript:history.back()" class="btn-action btn-secondary">
        <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i>
        <span>Go Back</span>
      </a>
    </div>
  </div>
  <script>
    if (window.lucide) { lucide.createIcons(); }
  </script>
</body>
</html>
