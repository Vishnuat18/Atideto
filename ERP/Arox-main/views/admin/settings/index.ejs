<div class="erp-h1" style="margin-bottom: 24px; color: #000000;">
  <div style="font-size: 26px; font-weight: 750;">System Settings & ERP Preferences</div>
  <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">Organization profile, fiscal credentials, document generator defaults, and CRM settings</div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 24px; margin-bottom: 32px;">
  <!-- Organization Profile -->
  <div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; padding: 24px;">
    <h3 style="font-size: 16px; font-weight: 750; color: #000; margin: 0 0 16px 0;">Organization Information</h3>
    <form onsubmit="event.preventDefault(); alert('Settings updated successfully!');">
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Entity Name</label>
          <input type="text" value="<%= org.name %>" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>
        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Registered Address</label>
          <input type="text" value="<%= org.address %>" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Support Phone</label>
            <input type="text" value="<%= org.phone %>" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Official Email</label>
            <input type="email" value="<%= org.email %>" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
          </div>
        </div>
        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">GSTIN / Tax Identification</label>
          <input type="text" value="<%= org.gstin %>" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>
        <button type="submit" style="padding: 8px 16px; background: #000; color: #fff; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; align-self: flex-start; margin-top: 6px;">
          Save Organization Info
        </button>
      </div>
    </form>
  </div>

  <!-- ERP CRM Preferences -->
  <div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; padding: 24px;">
    <h3 style="font-size: 16px; font-weight: 750; color: #000; margin: 0 0 16px 0;">CRM & Pipeline Configurations</h3>
    <div style="display: flex; flex-direction: column; gap: 16px; font-size: 13px;">
      <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
        <div>
          <div style="font-weight: 600; color: #000;">Auto-assign Inbound Leads</div>
          <div style="font-size: 12px; color: #64748B;">Round-robin assign new website registrations to available sales staff</div>
        </div>
        <input type="checkbox" checked style="accent-color: #000; width: 16px; height: 16px;">
      </label>

      <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
        <div>
          <div style="font-weight: 600; color: #000;">Follow-up Overdue Alerts</div>
          <div style="font-size: 12px; color: #64748B;">Highlight uncontacted follow-ups older than 24 hours in dashboard</div>
        </div>
        <input type="checkbox" checked style="accent-color: #000; width: 16px; height: 16px;">
      </label>

      <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
        <div>
          <div style="font-weight: 600; color: #000;">Document Generator Auto-Verification QR</div>
          <div style="font-size: 12px; color: #64748B;">Embed cryptographic verification QR code on certificates & offer letters</div>
        </div>
        <input type="checkbox" checked style="accent-color: #000; width: 16px; height: 16px;">
      </label>

      <div style="margin-top: 12px; padding-top: 16px; border-top: 1px solid #E2E8F0;">
        <span style="font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">DATABASE ENGINE</span>
        <div style="font-weight: 600; color: #000; margin-top: 2px;">SQLite with Disk Persistence (atideto.sqlite)</div>
        <div style="font-size: 12px; color: #16A34A; margin-top: 2px;">● Status: Online & Synchronized</div>
      </div>
    </div>
  </div>
</div>
