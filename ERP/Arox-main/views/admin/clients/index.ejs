<div class="erp-h1" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>
    <div style="font-size: 26px; font-weight: 750;">Corporate & Institutional Clients</div>
    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">Company directory, college MOUs, and employee account allocation</div>
  </div>
  <button onclick="openAdminAddClientModal()" class="erp-btn erp-btn-sm" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #000; color: #fff; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; border: none;">
    <i data-lucide="plus" style="width: 15px; height: 15px;"></i>
    <span>Add Client</span>
  </button>
</div>

<!-- Filters -->
<div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 18px; border-radius: 12px; margin-bottom: 24px;">
  <form method="GET" action="/admin/clients" style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;">
    <div style="flex: 1; min-width: 240px; position: relative;">
      <i data-lucide="search" style="position: absolute; left: 12px; top: 11px; width: 16px; height: 16px; color: #94A3B8;"></i>
      <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Search clients by name, contact or phone..." style="width: 100%; height: 40px; padding-left: 38px; padding-right: 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 13px; outline: none;">
    </div>

    <!-- Assigned Employee Filter -->
    <select name="assigned_to" onchange="this.form.submit()" style="height: 40px; padding: 0 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 13px; background: #fff;">
      <option value="">All Account Managers</option>
      <% if (employees && employees.length > 0) { %>
        <% employees.forEach(emp => { %>
          <option value="<%= emp.id %>" <%= filters.assigned_to == emp.id ? 'selected' : '' %>>
            <%= emp.first_name %> <%= emp.last_name %>
          </option>
        <% }) %>
      <% } %>
    </select>

    <!-- Industry Filter -->
    <select name="industry" onchange="this.form.submit()" style="height: 40px; padding: 0 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 13px; background: #fff;">
      <option value="all">All Industries</option>
      <option value="IT & Software" <%= filters.industry === 'IT & Software' ? 'selected' : '' %>>IT & Software</option>
      <option value="Education & Colleges" <%= filters.industry === 'Education & Colleges' ? 'selected' : '' %>>Education & Colleges</option>
      <option value="Healthcare Tech" <%= filters.industry === 'Healthcare Tech' ? 'selected' : '' %>>Healthcare Tech</option>
      <option value="Financial Services" <%= filters.industry === 'Financial Services' ? 'selected' : '' %>>Financial Services</option>
      <option value="Manufacturing" <%= filters.industry === 'Manufacturing' ? 'selected' : '' %>>Manufacturing</option>
    </select>

    <select name="status" onchange="this.form.submit()" style="height: 40px; padding: 0 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 13px; background: #fff;">
      <option value="all">All Statuses</option>
      <option value="prospect" <%= filters.status === 'prospect' ? 'selected' : '' %>>Prospect</option>
      <option value="contacted" <%= filters.status === 'contacted' ? 'selected' : '' %>>Contacted</option>
      <option value="partner" <%= filters.status === 'partner' ? 'selected' : '' %>>Partner</option>
      <option value="closed" <%= filters.status === 'closed' ? 'selected' : '' %>>Closed</option>
    </select>

    <button type="submit" style="height: 40px; padding: 0 16px; background: #000; color: #fff; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; border: none;">Filter</button>
  </form>
</div>

<!-- Clients Table -->
<div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; overflow-x: auto;">
  <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
    <thead>
      <tr style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0; font-size: 11px; text-transform: uppercase; color: #64748B; font-weight: 700;">
        <th style="padding: 12px 16px;">Code</th>
        <th style="padding: 12px 16px;">Company Name</th>
        <th style="padding: 12px 16px;">Contact Person</th>
        <th style="padding: 12px 16px;">Industry & Location</th>
        <th style="padding: 12px 16px;">Assigned Staff</th>
        <th style="padding: 12px 16px;">Status</th>
      </tr>
    </thead>
    <tbody>
      <% if (clients && clients.length > 0) { %>
        <% clients.forEach(client => { %>
          <tr style="border-bottom: 1px solid #E2E8F0;">
            <td style="padding: 12px 16px; font-weight: 600; color: #64748B;"><%= client.client_code %></td>
            <td style="padding: 12px 16px; font-weight: 700; color: #000;"><%= client.company_name %></td>
            <td style="padding: 12px 16px; color: #334155;">
              <div><%= client.contact_person %></div>
              <div style="font-size: 11px; color: #64748B;"><%= client.phone %> &bull; <%= client.email %></div>
            </td>
            <td style="padding: 12px 16px; color: #475569;">
              <div><%= client.industry %></div>
              <div style="font-size: 11px; color: #64748B;"><%= client.location %></div>
            </td>
            <td style="padding: 12px 16px;">
              <% if (client.assignee_first_name) { %>
                <span style="font-weight: 600; color: #000;"><%= client.assignee_first_name %> <%= client.assignee_last_name %></span>
              <% } else { %>
                <span style="color: #94A3B8;">Unassigned</span>
              <% } %>
            </td>
            <td style="padding: 12px 16px;">
              <% if (client.status === 'partner') { %>
                <span style="font-size: 11px; font-weight: 700; padding: 2px 7px; background: #000; color: #fff; border-radius: 4px; text-transform: uppercase;">
                  <%= client.status %>
                </span>
              <% } else { %>
                <span style="font-size: 11px; font-weight: 700; padding: 2px 7px; background: #F1F5F9; color: #000; border-radius: 4px; text-transform: uppercase;">
                  <%= client.status %>
                </span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="6" style="padding: 32px; text-align: center; color: #64748B;">No clients found.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
