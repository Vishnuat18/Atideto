<div class="erp-h1" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>
    <div style="font-size: 26px; font-weight: 750;">Employee Task Delegation & Workflows</div>
    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">Assign outreach tasks, monitor project deliverables, and track staff completion</div>
  </div>
  <button onclick="openAdminCreateTaskModal()" class="erp-btn erp-btn-sm" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #000; color: #fff; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; border: none;">
    <i data-lucide="plus" style="width: 15px; height: 15px;"></i>
    <span>Assign Task</span>
  </button>
</div>

<style>
  .admin-task-tab {
    padding: 6px 12px; font-size: 12px; font-weight: 600; border-radius: 6px; text-decoration: none; color: #64748B; background: transparent; transition: all 0.15s ease;
  }
  .admin-task-tab.active {
    color: #000; background: #fff;
  }
</style>

<!-- Task Stats & Filters -->
<div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 14px 18px; border-radius: 12px; margin-bottom: 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
  <div style="display: inline-flex; background: #F1F5F9; padding: 3px; border-radius: 8px;">
    <a href="/admin/tasks?status=all" class="admin-task-tab <%= activeStatus === 'all' ? 'active' : '' %>">
      All (<%= stats.total %>)
    </a>
    <a href="/admin/tasks?status=todo" class="admin-task-tab <%= activeStatus === 'todo' ? 'active' : '' %>">
      To Do (<%= stats.todo %>)
    </a>
    <a href="/admin/tasks?status=in_progress" class="admin-task-tab <%= activeStatus === 'in_progress' ? 'active' : '' %>">
      In Progress (<%= stats.in_progress %>)
    </a>
    <a href="/admin/tasks?status=completed" class="admin-task-tab <%= activeStatus === 'completed' ? 'active' : '' %>">
      Completed (<%= stats.completed %>)
    </a>
  </div>

  <form method="GET" action="/admin/tasks" style="display: flex; gap: 8px; align-items: center;">
    <input type="hidden" name="status" value="<%= activeStatus %>">
    <select name="assigned_to" onchange="this.form.submit()" style="height: 36px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 12px; background: #fff;">
      <option value="">All Assignees</option>
      <% if (employees && employees.length > 0) { %>
        <% employees.forEach(emp => { %>
          <option value="<%= emp.id %>" <%= filters.assigned_to == emp.id ? 'selected' : '' %>>
            <%= emp.first_name %> <%= emp.last_name %>
          </option>
        <% }) %>
      <% } %>
    </select>
  </form>
</div>

<!-- Tasks Table -->
<div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; overflow-x: auto;">
  <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
    <thead>
      <tr style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0; font-size: 11px; text-transform: uppercase; color: #64748B; font-weight: 700;">
        <th style="padding: 12px 16px;">Task Title</th>
        <th style="padding: 12px 16px;">Assigned Staff</th>
        <th style="padding: 12px 16px;">Category</th>
        <th style="padding: 12px 16px;">Priority</th>
        <th style="padding: 12px 16px;">Due Date</th>
        <th style="padding: 12px 16px;">Status</th>
      </tr>
    </thead>
    <tbody>
      <% if (tasks && tasks.length > 0) { %>
        <% tasks.forEach(task => { %>
          <tr style="border-bottom: 1px solid #E2E8F0;">
            <td style="padding: 12px 16px;">
              <% if (task.status === 'completed') { %>
                <div style="font-weight: 700; color: #64748B; text-decoration: line-through;">
                  <%= task.title %>
                </div>
              <% } else { %>
                <div style="font-weight: 700; color: #000;">
                  <%= task.title %>
                </div>
              <% } %>
              <% if (task.description) { %>
                <div style="font-size: 11px; color: #64748B;"><%= task.description %></div>
              <% } %>
            </td>
            <td style="padding: 12px 16px; font-weight: 600; color: #000;">
              <%= task.assignee_first_name || 'Staff' %> <%= task.assignee_last_name || '' %>
            </td>
            <td style="padding: 12px 16px; text-transform: uppercase; font-size: 11px; font-weight: 600; color: #475569;">
              <%= task.category.replace('_', ' ') %>
            </td>
            <td style="padding: 12px 16px; text-transform: capitalize; font-weight: 600;">
              <%= task.priority %>
            </td>
            <td style="padding: 12px 16px; font-size: 12px; color: #475569;">
              <%= task.due_date || 'None' %>
            </td>
            <td style="padding: 12px 16px;">
              <% if (task.status === 'completed') { %>
                <span style="font-size: 11px; font-weight: 700; padding: 2px 7px; background: #000; color: #fff; border-radius: 4px; text-transform: uppercase;">
                  <%= task.status.replace('_', ' ') %>
                </span>
              <% } else { %>
                <span style="font-size: 11px; font-weight: 700; padding: 2px 7px; background: #F1F5F9; color: #000; border-radius: 4px; text-transform: uppercase;">
                  <%= task.status.replace('_', ' ') %>
                </span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="6" style="padding: 32px; text-align: center; color: #64748B;">No tasks found.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<!-- Modal: Assign Task -->
<div id="adminCreateTaskModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #fff; border-radius: 14px; width: 100%; max-width: 480px; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h3 style="font-size: 18px; font-weight: 750; color: #000; margin: 0;">Assign Employee Task</h3>
      <button onclick="closeAdminCreateTaskModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #64748B;">&times;</button>
    </div>

    <form id="adminTaskForm" onsubmit="handleAdminCreateTask(event)">
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Assign To Employee *</label>
          <select name="assigned_to" required style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; background: #fff;">
            <% if (employees && employees.length > 0) { %>
              <% employees.forEach(emp => { %>
                <option value="<%= emp.id %>"><%= emp.first_name %> <%= emp.last_name %> (<%= emp.email %>)</option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Task Title *</label>
          <input type="text" name="title" required placeholder="e.g. Follow up on corporate training quotation" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>

        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Description / Instructions</label>
          <textarea name="description" rows="2" placeholder="Actionable steps for employee..." style="width: 100%; padding: 8px 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; resize: vertical;"></textarea>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Priority</label>
            <select name="priority" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; background: #fff;">
              <option value="high">High Priority</option>
              <option value="medium" selected>Medium Priority</option>
              <option value="low">Low Priority</option>
            </select>
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Due Date</label>
            <input type="date" name="due_date" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
          </div>
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px;">
        <button type="button" onclick="closeAdminCreateTaskModal()" style="padding: 8px 16px; background: #F1F5F9; color: #334155; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">Cancel</button>
        <button type="submit" id="saveAdminTaskBtn" style="padding: 8px 18px; background: #000; color: #fff; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">Assign Task</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openAdminCreateTaskModal() {
    document.getElementById('adminCreateTaskModal').style.display = 'flex';
  }
  function closeAdminCreateTaskModal() {
    document.getElementById('adminCreateTaskModal').style.display = 'none';
  }

  async function handleAdminCreateTask(e) {
    e.preventDefault();
    const btn = document.getElementById('saveAdminTaskBtn');
    btn.disabled = true;
    btn.textContent = 'Assigning...';

    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    try {
      const res = await fetch('/api/employee/tasks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        window.location.reload();
      } else {
        alert(result.message || 'Failed to assign task');
        btn.disabled = false;
        btn.textContent = 'Assign Task';
      }
    } catch (err) {
      alert('Error assigning task');
      btn.disabled = false;
      btn.textContent = 'Assign Task';
    }
  }
</script>
