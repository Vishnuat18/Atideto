<div class="erp-h1" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>
    <div style="font-size: 26px; font-weight: 750;">Company Follow-ups & Communications</div>
    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">Monitor client touchpoints, meeting schedules, and conversion logs across your team</div>
  </div>
</div>

<style>
  .admin-tab-link {
    padding: 6px 12px; font-size: 12px; font-weight: 600; border-radius: 6px; text-decoration: none; color: #64748B; background: transparent; transition: all 0.15s ease;
  }
  .admin-tab-link.active {
    color: #000; background: #fff;
  }
</style>

<!-- Tabs & Employee Filter -->
<div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 14px 18px; border-radius: 12px; margin-bottom: 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
  <div style="display: inline-flex; background: #F1F5F9; padding: 3px; border-radius: 8px;">
    <a href="/admin/follow-ups?tab=all" class="admin-tab-link <%= activeTab === 'all' ? 'active' : '' %>">
      All (<%= stats.total %>)
    </a>
    <a href="/admin/follow-ups?tab=today" class="admin-tab-link <%= activeTab === 'today' ? 'active' : '' %>">
      Today (<%= stats.today %>)
    </a>
    <a href="/admin/follow-ups?tab=overdue" class="admin-tab-link <%= activeTab === 'overdue' ? 'active' : '' %>">
      Overdue (<%= stats.overdue %>)
    </a>
    <a href="/admin/follow-ups?tab=completed" class="admin-tab-link <%= activeTab === 'completed' ? 'active' : '' %>">
      Completed (<%= stats.completed %>)
    </a>
  </div>

  <form method="GET" action="/admin/follow-ups" style="display: flex; gap: 8px; align-items: center;">
    <input type="hidden" name="tab" value="<%= activeTab %>">
    <select name="employee_id" onchange="this.form.submit()" style="height: 36px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 12px; background: #fff;">
      <option value="">All Staff Members</option>
      <% if (employees && employees.length > 0) { %>
        <% employees.forEach(emp => { %>
          <option value="<%= emp.id %>" <%= filters.employee_id == emp.id ? 'selected' : '' %>>
            <%= emp.first_name %> <%= emp.last_name %>
          </option>
        <% }) %>
      <% } %>
    </select>
  </form>
</div>

<!-- Follow-ups Table -->
<div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; overflow-x: auto;">
  <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
    <thead>
      <tr style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0; font-size: 11px; text-transform: uppercase; color: #64748B; font-weight: 700;">
        <th style="padding: 12px 16px;">Scheduled At</th>
        <th style="padding: 12px 16px;">Title & Agenda</th>
        <th style="padding: 12px 16px;">Client / Deal</th>
        <th style="padding: 12px 16px;">Type</th>
        <th style="padding: 12px 16px;">Staff Member</th>
        <th style="padding: 12px 16px;">Status / Result</th>
      </tr>
    </thead>
    <tbody>
      <% if (followUps && followUps.length > 0) { %>
        <% followUps.forEach(f => { %>
          <tr style="border-bottom: 1px solid #E2E8F0;">
            <td style="padding: 12px 16px; font-size: 12px; color: #475569;">
              <%= new Date(f.scheduled_at).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
            </td>
            <td style="padding: 12px 16px; font-weight: 700; color: #000;">
              <div><%= f.title %></div>
              <% if (f.notes) { %>
                <div style="font-size: 11px; font-weight: 400; color: #64748B;"><%= f.notes %></div>
              <% } %>
            </td>
            <td style="padding: 12px 16px; color: #334155;">
              <%= f.lead_company || f.client_company || 'Corporate Client' %>
            </td>
            <td style="padding: 12px 16px; text-transform: capitalize; font-weight: 600;">
              <%= f.type.replace('_', ' ') %>
            </td>
            <td style="padding: 12px 16px; font-weight: 600; color: #000;">
              <%= f.employee_first_name || 'Staff' %> <%= f.employee_last_name || '' %>
            </td>
            <td style="padding: 12px 16px;">
              <% if (f.status === 'completed') { %>
                <span style="font-size: 11px; font-weight: 700; padding: 2px 7px; background: #000; color: #fff; border-radius: 4px;">
                  Done (<%= f.outcome || 'Logged' %>)
                </span>
              <% } else if (new Date(f.scheduled_at) < new Date()) { %>
                <span style="font-size: 11px; font-weight: 700; padding: 2px 7px; background: #FEE2E2; color: #DC2626; border-radius: 4px;">
                  Overdue
                </span>
              <% } else { %>
                <span style="font-size: 11px; font-weight: 600; padding: 2px 7px; background: #F1F5F9; color: #000; border-radius: 4px;">
                  Scheduled
                </span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="6" style="padding: 32px; text-align: center; color: #64748B;">No follow-ups recorded.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
